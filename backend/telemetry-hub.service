[Unit]
Description=Bruin Racing "Pit Sync" Telemetry Hub
After=network.target

[Service]
# We assume the Pi's default user is 'daqpi', but this can be adjusted.
User=daqpi
WorkingDirectory=/home/daqpi/DAQ_VCU_SUITE/backend
Environment="LOG_DIR=/home/daqpi/telemetry_logs"
Environment="SERIAL_BAUD=115200"
Environment="CAN_INTERFACE=can1"

# Execute the FastAPI server on 0.0.0.0 to listen on all interfaces (USB and Wi-Fi)
# We use a virtual environment located at /home/daqpi/venv
ExecStart=/home/daqpi/venv/bin/python -m uvicorn backend_engine:app --host 0.0.0.0 --port 8000

# Automatically restart if the process crashes
Restart=always
RestartSec=3

# Set higher priority for telemetry processing
Nice=-10

[Install]
WantedBy=multi-user.target
